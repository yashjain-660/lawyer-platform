# ============================================================================
# THE WEB VALE - PRODUCTION ENVIRONMENT CONFIGURATION
# Generated: 2026-08-28
# Status: PRODUCTION DEPLOYMENT
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=postgresql://webvale_app:$DB_PASSWORD@postgres:5432/webvale_production
DB_USER=webvale_app
DB_PASSWORD=$DB_PASSWORD
DB_NAME=webvale_production
DB_PORT=5432
DB_HOST=postgres
DB_POOL_MIN=10
DB_POOL_MAX=30
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=900000

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=$REDIS_PASSWORD
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECTION_TIMEOUT=5000
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20

# ============================================================================
# APPLICATION CORE
# ============================================================================
NODE_ENV=production
PORT=5000
ENVIRONMENT=production
VERSION=1.0.0
BUILD_ID=prod-2026-08-28

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
JWT_SECRET=$JWT_SECRET
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
SESSION_SECRET=$SESSION_SECRET
SESSION_TIMEOUT=1800000
ENCRYPTION_KEY=$ENCRYPTION_KEY
SECURE_COOKIE=true
CSRF_PROTECTION=true
CORS_CREDENTIALS=true
CORS_PREFLIGHT_CONTINUE=false

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS=https://advocate-legal.thewebvale.com,https://admin.advocate-legal.thewebvale.com,https://thewebvale.com,https://*.thewebvale.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-CSRF-Token,X-Requested-With
CORS_EXPOSE_HEADERS=X-Total-Count,X-Page-Count

# ============================================================================
# EMAIL SERVICE (SendGrid)
# ============================================================================
SENDGRID_API_KEY=SG.REPLACE_WITH_PRODUCTION_KEY
SENDER_EMAIL=noreply@thewebvale.com
SENDER_NAME=The Web Vale
EMAIL_VERIFICATION_ENABLED=true
EMAIL_RATE_LIMIT=100/hour

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================
# Razorpay Production Keys
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
ENABLE_RAZORPAY=true

# Stripe Production Keys
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
ENABLE_STRIPE=true

# Payment Configuration
PAYMENT_CURRENCY=USD
PAYMENT_TIMEOUT=30000
TRANSACTION_LOG_RETENTION=90d

# ============================================================================
# CLOUD STORAGE (AWS S3)
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_KEY
S3_BUCKET_NAME=webvale-production-files
S3_BUCKET_REGION=us-east-1
S3_OBJECT_ACL=private
S3_MAX_FILE_SIZE=104857600
S3_ALLOWED_MIMETYPES=application/pdf,image/jpeg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=30
LOG_ROTATION=daily
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_LOGGING=true
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION=90d

# Cloud Logging Integration (Google Cloud / CloudWatch)
CLOUD_LOGGING_ENABLED=false
CLOUD_PROJECT_ID=REPLACE_WITH_PROJECT_ID

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# MONITORING & HEALTH CHECKS
# ============================================================================
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
PROMETHEUS_ENABLED=false
DATADOG_ENABLED=false
DATADOG_API_KEY=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_OAUTH=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_RATE_LIMITING=true
ENABLE_REQUEST_LOGGING=true
ENABLE_CACHING=true
ENABLE_CDN=true
FEATURE_NEW_DASHBOARD=true
FEATURE_ADVANCED_SEARCH=true

# ============================================================================
# ADMIN SETTINGS
# ============================================================================
ADMIN_EMAIL=admin@thewebvale.com
ADMIN_DEFAULT_PASSWORD=$ADMIN_PASSWORD
ADMIN_REQUIRE_MFA=true
ADMIN_SESSION_TIMEOUT=900000
ADMIN_IP_WHITELIST=

# ============================================================================
# API RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_SEARCH_MAX_REQUESTS=50
RATE_LIMIT_FILE_UPLOAD_MAX_REQUESTS=10

# ============================================================================
# DATABASE BACKUP
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_ENCRYPT=true
BACKUP_S3_ENABLED=true
BACKUP_S3_BUCKET=webvale-backups
BACKUP_S3_RETENTION_DAYS=30

# ============================================================================
# PERFORMANCE & OPTIMIZATION
# ============================================================================
CONNECTION_POOL_SIZE=30
QUERY_TIMEOUT=30000
MAX_REQUEST_SIZE=104857600
COMPRESSION_THRESHOLD=1024
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# ============================================================================
# SECURITY HEADERS
# ============================================================================
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
CSP_ENABLED=true
CSP_REPORT_URI=https://advocate-legal.thewebvale.com/api/security/csp-report
X_FRAME_OPTIONS=SAMEORIGIN
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block

# ============================================================================
# ENVIRONMENT-SPECIFIC SETTINGS
# ============================================================================
DOMAIN=thewebvale.com
SUBDOMAIN_PATTERN=*.thewebvale.com
INSTANCE_ID=prod-primary-1
CLUSTER_NAME=production-cluster
REGION=us-east-1

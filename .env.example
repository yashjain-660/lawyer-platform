# Database Configuration
DATABASE_URL=postgresql://lawyer:secure_password_123@postgres:5432/lawyer_platform
DB_USER=lawyer
DB_PASSWORD=secure_password_123
DB_NAME=lawyer_platform
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Application
NODE_ENV=production
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Email Service (SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDER_EMAIL=noreply@legalhub.com

# Payment Gateways
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=lawyer-platform-files

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# Logging
LOG_LEVEL=info

# Session & Auth
SESSION_SECRET=your_session_secret_key_here
TOKEN_EXPIRY=7d

# Email Templates
EMAIL_TEMPLATE_PATH=./src/templates/emails

# Encryption
ENCRYPTION_KEY=your_encryption_key_32_chars_long_here

# Admin Settings
ADMIN_EMAIL=admin@legalhub.com
ADMIN_PASSWORD=change_this_secure_password

# Feature Flags
ENABLE_RAZORPAY=true
ENABLE_STRIPE=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR=false

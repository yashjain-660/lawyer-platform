# Database Configuration
DATABASE_URL=postgresql://lawyer:secure_password_123@postgres:5432/lawyer_platform
DB_USER=lawyer
DB_PASSWORD=secure_password_123
DB_NAME=lawyer_platform
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Application
NODE_ENV=development
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_development_mode_only_change_in_production_xyz123

# Email Service (SendGrid)
SENDGRID_API_KEY=SG.test_key_for_development
SENDER_EMAIL=noreply@legalhub.local

# Payment Gateways
RAZORPAY_KEY_ID=rzp_test_development_key
RAZORPAY_KEY_SECRET=test_razorpay_secret
STRIPE_SECRET_KEY=sk_test_development_key
STRIPE_PUBLISHABLE_KEY=pk_test_development_key

# AWS S3 Storage
AWS_ACCESS_KEY_ID=test_aws_key
AWS_SECRET_ACCESS_KEY=test_aws_secret
AWS_REGION=us-east-1
S3_BUCKET_NAME=lawyer-platform-files-dev

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Logging
LOG_LEVEL=info

# Session & Auth
SESSION_SECRET=your_session_secret_key_development
TOKEN_EXPIRY=7d

# Email Templates
EMAIL_TEMPLATE_PATH=./src/templates/emails

# Encryption
ENCRYPTION_KEY=dev_encryption_key_32_chars_long_

# Admin Settings
ADMIN_EMAIL=admin@legalhub.local
ADMIN_PASSWORD=AdminPassword123!

# Feature Flags
ENABLE_RAZORPAY=false
ENABLE_STRIPE=false
ENABLE_EMAIL_VERIFICATION=false
ENABLE_TWO_FACTOR=false
